508]]],["أَنِ","that","ani",""],["ٱشْكُرْ","Be grateful","ush'kur",""],["لِلَّهِ","to Allah","lillahi","ۚ",[["لِ",8],["لَّهِ",9]]],["وَمَن","And whoever","waman","",[["وَ",1],["مَن",25]]],["يَشْكُرْ","(is) grateful","yashkur",""],["فَإِنَّمَا","then only","fa-innamā","",[["فَ",7],["إِنَّ",15],["مَا",0]]],["يَشْكُرُ","he is grateful","yashkuru",""],["لِنَفْسِهِۦ","for himself","linafsihi","ۖ",[["لِ",8],["نَفْسِ",51],["هِۦ",5]]],["وَمَن","And whoever","waman","",[["وَ",1],["مَن",25]]],["كَفَرَ","(is) ungrateful","kafara",""],["فَإِنَّ","then indeed","fa-inna","",[["فَ",7],["إِنَّ",15]]],["ٱللَّهَ","Allah","l-laha",""],["غَنِىٌّ","(is) Free of need","ghaniyyun",""],["حَمِيدٌۭ","Praiseworthy","ḥamīdun",""]]},{"t":"And [mention, O Muḥammad], when Luqmān said to his son while he was instructing him, \"O my son, do not associate [anything] with Allāh. Indeed, association [with Him] is great injustice.\"","w":[["وَإِذْ","And when","wa-idh","",[["وَ",1],["إِذْ",50]]],["قَالَ","said","qāla",""],["لُقْمَـٰنُ","Luqman","luq'mānu",""],["لِٱبْنِهِۦ","to his son","li-ib'nihi","",[["لِ",8],["ٱبْنِ",97],["هِۦ",5]]],["وَهُوَ","while he","wahuwa","",[["وَ",1],["هُوَ",5]]],["يَعِظُهُۥ","(was) instructing him","yaʿiẓuhu","",[["يَعِظُ",636],["هُۥ",5]]],["يَـٰبُنَىَّ","O my son","yābunayya","",[["يَ",42],["ـٰبُنَىَّ",97],["",20]]],["لَا","(Do) not","lā",""],["تُشْرِكْ","associate partners","tush'rik",""],["بِٱللَّهِ","with Allah","bil-lahi","ۖ",[["بِ",10],["ٱللَّهِ",9]]],["إِنَّ","Indeed","inna",""],["ٱلشِّرْكَ","associating partners","l-shir'ka","",[["ٱل",2],["شِّرْكَ",1350]]],["لَظُلْمٌ","(is) surely an injustice","laẓul'mun","",[["لَ",23],["ظُلْمٌ",512]]],["عَظِيمٌۭ","great","ʿaẓīmun",""]]},{"t":"And We have enjoined upon man [care] for his parents. His mother carried him, [increasing her] in weakness upon weakness, and his weaning is in two years. Be grateful to Me and to your parents; to Me is the [final] destination.","w":[["وَوَصَّيْنَا","And We have enjoined","wawaṣṣaynā","",[["وَ