]],["أُو۟لَـٰٓئِكَ","Those","ulāika","",[["أُو۟لَـٰٓئِ",72],["كَ",0]]],["هُمُ","(are) they ","humu",""],["ٱلرَّٰشِدُونَ","the guided ones","l-rāshidūna","",[["ٱل",2],["رَّٰشِدُونَ",3514]]]]},{"t":"[It is] as bounty from Allāh and favor. And Allāh is Knowing and Wise.","w":[["فَضْلًۭا","A Bounty","faḍlan",""],["مِّنَ","from Allah","mina",""],["ٱللَّهِ","from Allah","l-lahi",""],["وَنِعْمَةًۭ","and favor","waniʿ'matan","ۚ",[["وَ",1],["نِعْمَةًۭ",247]]],["وَٱللَّهُ","And Allah","wal-lahu","",[["وَ",1],["ٱللَّهُ",9]]],["عَلِيمٌ","(is) All-Knower","ʿalīmun",""],["حَكِيمٌۭ","All-Wise","ḥakīmun",""]]},{"t":"And if two factions among the believers should fight, then make settlement between the two. But if one of them oppresses the other, then fight against the one that oppresses until it returns to the ordinance of Allāh. And if it returns, then make settlement between them in justice and act justly. Indeed, Allāh loves those who act justly.","w":[["وَإِن","And if","wa-in","",[["وَ",1],["إِن",27]]],["طَآئِفَتَانِ","two parties","ṭāifatāni",""],["مِنَ","among","mina",""],["ٱلْمُؤْمِنِينَ","the believers","l-mu'minīna","",[["ٱلْ",2],["مُؤْمِنِينَ",70]]],["ٱقْتَتَلُوا۟","fight","iq'tatalū","",[["ٱقْتَتَلُ",1482],["وا۟",3]]],["فَأَصْلِحُوا۟","then make peace","fa-aṣliḥū","",[["فَ",7],["أَصْلِحُ",393],["وا۟",4]]],["بَيْنَهُمَا","between both of them","baynahumā","ۖ",[["بَيْنَ",61],["هُمَا",66]]],["فَإِنۢ","But if","fa-in","",[["فَ",7],["إِنۢ",27]]],["بَغَتْ","oppresses","baghat",""],["إِحْدَىٰهُمَا","one of them","iḥ'dāhumā","",[["إِحْدَىٰ",170],["هُمَا",66]]],["عَلَى","on","ʿalā",""],["ٱلْأُخْرَىٰ","the other","l-ukh'rā","",[["ٱلْ",2],["أُخْرَىٰ",184]]],["فَقَـٰتِلُوا۟","then fight","faqātilū","",[["فَ",7],["قَـٰتِلُ",229],["وا۟",4]]],["ٱلَّتِى","one which","allatī",""],["تَبْغِى","oppresses","tabghī",""],["حَتَّىٰ","until","ḥattā",""],["تَفِىٓءَ","it returns","tafīa",""],["إِلَىٰٓ","to","ilā",""],["أَمْرِ","(the) command","amri",""],["ٱللَّهِ","(of) Allah","l-lahi","ۚ"],["فَإ