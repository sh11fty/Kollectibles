 made","wajaʿala","",[["وَ",1],["جَعَلَ",45]]],["لَكُمُ","for you","lakumu","",[["لَ",8],["كُمُ",4]]],["ٱلسَّمْعَ","the hearing","l-samʿa","",[["ٱل",2],["سَّمْعَ",475]]],["وَٱلْأَبْصَـٰرَ","and the sight","wal-abṣāra","",[["وَ",1],["ٱلْ",2],["أَبْصَـٰرَ",256]]],["وَٱلْأَفْـِٔدَةَ","and feelings","wal-afidata","ۚ",[["وَ",1],["ٱلْ",2],["أَفْـِٔدَةَ",599]]],["قَلِيلًۭا","little","qalīlan",""],["مَّا","[what]","mā",""],["تَشْكُرُونَ","thanks you give","tashkurūna","",[["تَشْكُرُ",263],["ونَ",4]]]]},{"t":"And they say, \"When we are lost [i.e., disintegrated] within the earth, will we indeed be [recreated] in a new creation?\" Rather, they are, in the meeting with their Lord, disbelievers.","w":[["وَقَالُوٓا۟","And they say","waqālū","",[["وَ",1],["قَالُ",16],["وٓا۟",3]]],["أَءِذَا","Is (it) when","a-idhā","",[["أَءِ",31],["ذَا",36]]],["ضَلَلْنَا","we are lost","ḍalalnā","",[["ضَلَلْ",233],["نَا",11]]],["فِى","in","fī",""],["ٱلْأَرْضِ","the earth","l-arḍi","",[["ٱلْ",2],["أَرْضِ",35]]],["أَءِنَّا","will we","a-innā","",[["أَءِ",31],["نَّ",15],["ا",11]]],["لَفِى","certainly be in","lafī","",[["لَ",23],["فِى",14]]],["خَلْقٍۢ","a creation","khalqin",""],["جَدِيدٍۭ","new","jadīdin","ۚ"],["بَلْ","Nay","bal",""],["هُم","they","hum",""],["بِلِقَآءِ","in (the) meeting","biliqāi","",[["بِ",10],["لِقَآءِ",448]]],["رَبِّهِمْ","(of) their Lord","rabbihim","",[["رَبِّ",24],["هِمْ",3]]],["كَـٰفِرُونَ","(are) disbelievers","kāfirūna",""]]},{"t":"Say, \"The angel of death who has been entrusted with you will take you. Then to your Lord you will be returned.\"","w":[["قُلْ","Say","qul",""],["يَتَوَفَّىٰكُم","Will take your soul","yatawaffākum","",[["يَتَوَفَّىٰ",442],["كُم",4]]],["مَّلَكُ","(the) Angel","malaku",""],["ٱلْمَوْتِ","(of) the death","l-mawti","",[["ٱلْ",2],["مَوْتِ",246]]],["ٱلَّذِى","the one who","alladhī",""],["وُكِّلَ","has been put in charge","wukkila",""],["بِكُمْ","of you","bikum","",[["بِ",10],["كُمْ",4]]],["ثُمَّ","Then","thumma",""],["إِلَىٰ","to","ilā",""],["رَبِّكُمْ","your Lord","rabbikum","",[["رَبِّ",24],["كُمْ",4]]],["تُرْجَعُونَ","you will be returned","tur'jaʿūna","",[["تُرْجَعُ",157],["ونَ",4]]]]},{"t":"If you could but see when the criminals are hanging their heads before their Lord, [saying], \"Our Lord, we have seen and heard, so return us [to the world]; we will work righteousness. Indeed, we are [now] certain.\"","w":[["وَلَوْ","And if","walaw","",[["وَ",1],["لَوْ",73]]],["تَرَىٰٓ","you (could) see","tarā",""],["إِذِ","when","idhi",""],["ٱلْمُجْرِمُونَ","the criminals","l-muj'rimūna","",[["ٱلْ",2],["مُجْرِمُونَ",237]]],["نَاكِسُوا۟","(will) hang","nākisū",""],["رُءُوسِهِمْ","their heads","ruūsihim","",[["رُءُوسِ",547],["هِمْ",3]]],["عِندَ","before","ʿinda",""],["رَبِّهِمْ","their Lord","rabbihim","",[["رَبِّ",24],["هِمْ",3]]],["رَبَّنَآ","Our Lord","rabbanā","",[["رَبَّ",24],["نَآ",11]]],["أَبْصَرْنَا","we have seen","abṣarnā","",[["أَبْصَرْ",385],["نَا",11]]],["وَسَمِعْنَا","and we have heard","wasamiʿ'nā","",[["وَ",1],["سَمِعْ",160],["نَا",11]]],["فَٱرْجِعْنَا","so return us","fa-ir'jiʿ'nā","",[["فَ",7],["ٱرْجِعْ",157],["نَا",11]]],["نَعْمَلْ","we will do","naʿmal",""],["صَـٰلِحًا","righteous (deeds)","ṣāliḥan",""],["إِنَّا","Indeed, we","innā","",[["إِنَّ",15],["ا",11]]],["مُوقِنُونَ","(are now) certain","mūqinūna",""]]},{"t":"And if We had willed, We could have given every soul its guidance, but the word from Me will come into effect [that] \"I will surely fill Hell with jinn and people all together.","w":[["وَلَوْ","And if","walaw","",[["وَ",1],["لَوْ",73]]],["شِئْنَا","We (had) willed","shi'nā","",[["شِئْ",68],["نَا",11]]],["لَـَٔاتَيْنَا","surely We (would) have given","laātaynā","",[["لَ",23],["ـَٔاتَيْ",59],["نَا",11]]],["كُلَّ","every","kulla",""],["نَفْسٍ","soul","nafsin",""],["هُدَىٰهَا","its guidance","hudāhā","",[["هُدَىٰ",147],["هَا",22]]],["وَلَـٰكِنْ","but","walākin","",[["وَ",1],["لَـٰكِنْ",107]]],["حَقَّ","(is) true","ḥaqqa",""],["ٱلْقَوْلُ","the Word","l-qawlu","",[["ٱلْ",2],["قَوْلُ",137]