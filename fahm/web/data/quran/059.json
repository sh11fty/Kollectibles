["وَٱلَّذِينَ","And those who","wa-alladhīna","",[["وَ",1],["ٱلَّذِينَ",17]]],["جَآءُو","came","jāū","",[["جَآءُ",57],["و",3]]],["مِنۢ","from","min",""],["بَعْدِهِمْ","after them","baʿdihim","",[["بَعْدِ",74],["هِمْ",3]]],["يَقُولُونَ","they say","yaqūlūna","",[["يَقُولُ",16],["ونَ",3]]],["رَبَّنَا","Our Lord","rabbanā","",[["رَبَّ",24],["نَا",11]]],["ٱغْفِرْ","forgive","igh'fir",""],["لَنَا","us","lanā","",[["لَ",8],["نَا",11]]],["وَلِإِخْوَٰنِنَا","and our brothers","wali-ikh'wāninā","",[["وَ",1],["لِ",8],["إِخْوَٰنِ",166],["نَا",11]]],["ٱلَّذِينَ","who","alladhīna",""],["سَبَقُونَا","preceded us","sabaqūnā","",[["سَبَقُ",509],["و",3],["نَا",11]]],["بِٱلْإِيمَـٰنِ","in faith","bil-īmāni","",[["بِ",10],["ٱلْ",2],["إِيمَـٰنِ",266]]],["وَلَا","and (do) not","walā","",[["وَ",1],["لَا",13]]],["تَجْعَلْ","put","tajʿal",""],["فِى","in","fī",""],["قُلُوبِنَا","our hearts","qulūbinā","",[["قُلُوبِ",104],["نَا",11]]],["غِلًّۭا","any rancor","ghillan",""],["لِّلَّذِينَ","towards those who","lilladhīna","",[["لِّ",8],["لَّذِينَ",17]]],["ءَامَنُوا۟","believed","āmanū","",[["ءَامَنُ",30],["وا۟",3]]],["رَبَّنَآ","Our Lord","rabbanā","",[["رَبَّ",24],["نَآ",11]]],["إِنَّكَ","indeed You","innaka","",[["إِنَّ",15],["كَ",18]]],["رَءُوفٌۭ","(are) Full of Kindness","raūfun",""],["رَّحِيمٌ","Most Merciful","raḥīmun",""]]},{"t":"Have you not considered those who practice hypocrisy, saying to their brothers [i.e., associates] who have disbelieved among the People of the Scripture, \"If you are expelled, we will surely leave with you, and we will not obey, in regard to you, anyone - ever; and if you are fought, we will surely aid you.\" But Allāh testifies that they are liars.","w":[["أَلَمْ","Do not","alam","",[["أَ",31],["لَمْ",44]]],["تَرَ","you see","tara",""],["إِلَى","[to]","ilā",""],["ٱلَّذِينَ","those who","alladhīna",""],["نَافَقُوا۟","(were) hypocrites","nāfaqū","",[["نَافَقُ",2709],["وا۟",3]]],["يَقُولُونَ","saying","yaqūlūna","",[["يَقُولُ",16],["ونَ",3]]],["لِإِخْوَٰنِهِمُ","to their brothers","li-ikh'wānihimu","",[["لِ",8],["إِخْوَٰنِ",166],["هِمُ",3]]],["ٱلَّذِينَ","those who","alladhīna",""],["كَفَرُوا۟","disbelieved","kafarū","",[["كَفَرُ",53],["وا۟",3]]],["مِنْ","among","min",""],["أَهْلِ","the People","ahli",""],["ٱلْكِتَـٰبِ","(of) the Scripture","l-kitābi","",[["ٱلْ",2],["كِتَـٰبِ",63]]],["لَئِنْ","If","la-in","",[["لَ",23],["ئِنْ",27]]],["أُخْرِجْتُمْ","you are expelled","ukh'rij'tum","",[["أُخْرِجْ",131],["تُمْ",4]]],["لَنَخْرُجَنَّ","surely we will leave","lanakhrujanna","",[["لَ",23],["نَخْرُجَ",232],["نَّ",0]]],["مَعَكُمْ","with you","maʿakum","",[["مَعَ",84],["كُمْ",4]]],["وَلَا","and not","walā","",[["وَ",1],["لَا",13]]],["نُطِيعُ","we will obey","nuṭīʿu",""],["فِيكُمْ","concerning you","fīkum","",[["فِي",14],["كُمْ",4]]],["أَحَدًا","anyone","aḥadan",""],["أَبَدًۭا","ever","abadan",""],["وَإِن","and if","wa-in","",[["وَ",1],["إِن",27]]],["قُوتِلْتُمْ","you are fought","qūtil'tum","",[["قُوتِلْ",229],["تُمْ",4]]],["لَنَنصُرَنَّكُمْ","certainly we will help you","lananṣurannakum","",[["لَ",23],["نَنصُرَ",209],["نَّ",0],["كُمْ",4]]],["وَٱللَّهُ","And Allah","wal-lahu","",[["وَ",1],["ٱللَّهُ",9]]],["يَشْهَدُ","bears witness","yashhadu",""],["إِنَّهُمْ","that they","innahum","",[["إِنَّ",15],["هُمْ",3]]],["لَكَـٰذِبُونَ","(are) surely liars","lakādhibūna","",[["لَ",23],["كَـٰذِبُونَ",365]]]]},{"t":"If they are expelled, they will not leave with them, and if they are fought, they will not aid them. And [even] if they should aid them, they will surely turn their backs; then [thereafter] they will not be aided.","w":[["لَئِنْ","If","la-in","",[["لَ",23],["ئِنْ",27]]],["أُخْرِجُوا۟","they are expelled","ukh'rijū","",[["أُخْرِجُ",131],["وا۟",3]]],["لَا","not","lā",""],["يَخْرُجُونَ","they will leave","yakhrujūna","",[["يَخْرُجُ",232],["ونَ",3]]],["مَعَهُمْ","with them","maʿahum","",[["مَعَ",84],["هُمْ",3]]],["وَلَئِن","and if","wala-in","",[["وَ",1],["لَ",23],["ئِن",27]]],["قُوتِلُوا۟","they are fought","qūtilū","",[["قُوتِلُ",