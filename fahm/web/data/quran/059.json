in","ۚ"],["بَأْسُهُم","Their violence","basuhum","",[["بَأْسُ",428],["هُم",3]]],["بَيْنَهُمْ","among themselves","baynahum","",[["بَيْنَ",61],["هُمْ",3]]],["شَدِيدٌۭ","(is) severe","shadīdun","ۚ"],["تَحْسَبُهُمْ","You think they","taḥsabuhum","",[["تَحْسَبُ",273],["هُمْ",3]]],["جَمِيعًۭا","(are) united","jamīʿan",""],["وَقُلُوبُهُمْ","but their hearts","waqulūbuhum","",[["وَ",1],["قُلُوبُ",104],["هُمْ",3]]],["شَتَّىٰ","(are) divided","shattā","ۚ"],["ذَٰلِكَ","That","dhālika","",[["ذَٰ",32],["لِ",0],["كَ",0]]],["بِأَنَّهُمْ","(is) because they","bi-annahum","",[["بِ",10],["أَنَّ",41],["هُمْ",3]]],["قَوْمٌۭ","(are) a people","qawmun",""],["لَّا","not","lā",""],["يَعْقِلُونَ","they reason","yaʿqilūna","",[["يَعْقِلُ",250],["ونَ",3]]]]},{"t":"[Theirs is] like the example of those shortly before them: they tasted the bad consequence of their affair, and they will have a painful punishment.","w":[["كَمَثَلِ","Like (the) example","kamathali","",[["كَ",54],["مَثَلِ",142]]],["ٱلَّذِينَ","(of) those","alladhīna",""],["مِن","from","min",""],["قَبْلِهِمْ","before them","qablihim","",[["قَبْلِ",65],["هِمْ",3]]],["قَرِيبًۭا","shortly","qarīban","ۖ"],["ذَاقُوا۟","they tasted","dhāqū","",[["ذَاقُ",334],["وا۟",3]]],["وَبَالَ","(the) evil result","wabāla",""],["أَمْرِهِمْ","(of) their affair","amrihim","",[["أَمْرِ",82],["هِمْ",3]]],["وَلَهُمْ","and for them","walahum","",[["وَ",1],["لَ",8],["هُمْ",3]]],["عَذَابٌ","(is) a punishment","ʿadhābun",""],["أَلِيمٌۭ","painful","alīmun",""]]},{"t":"[The hypocrites are] like the example of Satan when he says to man, \"Disbelieve.\" But when he disbelieves, he says, \"Indeed, I am disassociated from you. Indeed, I fear Allāh, Lord of the worlds.\"","w":[["كَمَثَلِ","Like (the) example","kamathali","",[["كَ",54],["مَثَلِ",142]]],["ٱلشَّيْطَـٰنِ","(of) the Shaitaan","l-shayṭāni","",[["ٱل",2],["شَّيْطَـٰنِ",140]]],["إِذْ","when","idh",""],["قَالَ","he says","qāla",""],["لِلْإِنسَـٰنِ","to man","lil'insāni","",[["لِ",8],["لْ",2],["إِنسَـٰنِ",181]]