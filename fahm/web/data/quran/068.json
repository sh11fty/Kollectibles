ressors.","w":[["قَالُوا۟","They said","qālū","",[["قَالُ",16],["وا۟",3]]],["يَـٰوَيْلَنَآ","O woe to us","yāwaylanā","",[["يَ",42],["ـٰوَيْلَ",309],["نَآ",11]]],["إِنَّا","Indeed, we","innā","",[["إِنَّ",15],["ا",11]]],["كُنَّا","[we] were","kunnā","",[["كُ",21],["نَّا",11]]],["طَـٰغِينَ","transgressors","ṭāghīna",""]]},{"t":"Perhaps our Lord will substitute for us [one] better than it. Indeed, we are toward our Lord desirous.\"","w":[["عَسَىٰ","Perhaps","ʿasā",""],["رَبُّنَآ","our Lord","rabbunā","",[["رَبُّ",24],["نَآ",11]]],["أَن","[that]","an",""],["يُبْدِلَنَا","will substitute for us","yub'dilanā","",[["يُبْدِلَ",2085],["نَا",11]]],["خَيْرًۭا","a better","khayran",""],["مِّنْهَآ","than it","min'hā","",[["مِّنْ",6],["هَآ",22]]],["إِنَّآ","Indeed, we","innā","",[["إِنَّ",15],["آ",11]]],["إِلَىٰ","to","ilā",""],["رَبِّنَا","our Lord","rabbinā","",[["رَبِّ",24],["نَا",11]]],["رَٰغِبُونَ","turn devoutly","rāghibūna",""]]},{"t":"Such is the punishment [of this world]. And the punishment of the Hereafter is greater, if they only knew.","w":[["كَذَٰلِكَ","Such","kadhālika","",[["كَ",54],["ذَٰ",32],["لِ",0],["كَ",0]]],["ٱلْعَذَابُ","(is) the punishment","l-ʿadhābu","ۖ",[["ٱلْ",2],["عَذَابُ",48]]],["وَلَعَذَابُ","And surely the punishment","walaʿadhābu","",[["وَ",1],["لَ",23],["عَذَابُ",48]]],["ٱلْـَٔاخِرَةِ","(of) the Hereafter","l-ākhirati","",[["ٱلْ",2],["ـَٔاخِرَةِ",89]]],["أَكْبَرُ","(is) greater","akbaru","ۚ"],["لَوْ","if","law",""],["كَانُوا۟","they","kānū","",[["كَانُ",21],["وا۟",3]]],["يَعْلَمُونَ","know","yaʿlamūna","",[["يَعْلَمُ",40],["ونَ",3]]]]},{"t":"Indeed, for the righteous with their Lord are the Gardens of Pleasure.","w":[["إِنَّ","Indeed","inna",""],["لِلْمُتَّقِينَ","for the righteous","lil'muttaqīna","",[["لِ",8],["لْ",2],["مُتَّقِينَ",253]]],["عِندَ","with","ʿinda",""],["رَبِّهِمْ","their Lord","rabbihim","",[["رَبِّ",24],["هِمْ",3]]],["جَنَّـٰتِ","(are) Gardens","jannāti",""],["ٱلنَّعِيمِ","(of) Delight","l-naʿīmi","",[["ٱل",2],["نَّعِيم