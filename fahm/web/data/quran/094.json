{"s":94,"v":[{"t":"Did We not expand for you, [O Muḥammad], your breast?","w":[["أَلَمْ","Have not","alam","",[["أَ",31],["لَمْ",44]]],["نَشْرَحْ","We expanded","nashraḥ",""],["لَكَ","for you","laka","",[["لَ",8],["كَ",18]]],["صَدْرَكَ","your breast","ṣadraka","",[["صَدْرَ",275],["كَ",18]]]]},{"t":"And We removed from you your burden","w":[["وَوَضَعْنَا","And We removed","wawaḍaʿnā","",[["وَ",1],["وَضَعْ",499],["نَا",11]]],["عَنكَ","from you","ʿanka","",[["عَن",34],["كَ",18]]],["وِزْرَكَ","your burden","wiz'raka","",[["وِزْرَ",747],["كَ",18]]]]},{"t":"Which had weighed upon your back","w":[["ٱلَّذِىٓ","Which","alladhī",""],["أَنقَضَ","weighed upon","anqaḍa",""],["ظَهْرَكَ","your back","ẓahraka","",[["ظَهْرَ",626],["كَ",18]]]]},{"t":"And raised high for you your repute.","w":[["وَرَفَعْنَا","And We raised high","warafaʿnā","",[["وَ",1],["رَفَعْ",472],["نَا",11]]],["لَكَ","for you","laka","",[["لَ",8],["كَ",18]]],["ذِكْرَكَ","your reputation","dhik'raka","",[["ذِكْرَ",132],["كَ",18]]]]},{"t":"For indeed, with hardship [will be] ease [i.e., relief].","w":[["فَإِنَّ","So indeed","fa-inna","",[["فَ",7],["إِنَّ",15]]],["مَعَ","with","maʿa",""],["ٱلْعُسْرِ","the hardship","l-ʿus'ri","",[["ٱلْ",2],["عُسْرِ",1371]]],["يُسْرًا","(is) ease","yus'ran",""]]},{"t":"Indeed, with hardship [will be] ease.","w":[["إِنَّ","Indeed","inna",""],["مَعَ","with","maʿa",""],["ٱلْعُسْرِ","the hardship","l-ʿus'ri","",[["ٱلْ",2],["عُسْرِ",1371]]],["يُسْرًۭا","(is) ease","yus'ran",""]]},{"t":"So when you have finished [your duties], then stand up [for worship].","w":[["فَإِذَا","So when","fa-idhā","",[["فَ",7],["إِذَا",36]]],["فَرَغْتَ","you have finished","faraghta","",[["فَرَغْ",2550],["تَ",18]]],["فَٱنصَبْ","then labor hard","fa-inṣab","",[["فَ",7],["ٱنصَبْ",2729]]]]},{"t":"And to your Lord direct [your] longing.","w":[["وَإِلَىٰ","And to","wa-ilā","",[["وَ",1],["إِلَىٰ",26]]],["رَبِّكَ","your Lord","rabbika","",[["رَبِّ",24],["كَ",18]]],["فَٱرْغَب","turn your attention","fa-ir'ghab","",[["فَ",7],["ٱرْغَب",1675]]]]}]}