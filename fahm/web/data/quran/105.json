{"s":105,"v":[{"t":"Have you not considered, [O Muḥammad], how your Lord dealt with the companions of the elephant?","w":[["أَلَمْ","Have not","alam","",[["أَ",31],["لَمْ",44]]],["تَرَ","you seen","tara",""],["كَيْفَ","how","kayfa",""],["فَعَلَ","dealt","faʿala",""],["رَبُّكَ","your Lord","rabbuka","",[["رَبُّ",24],["كَ",18]]],["بِأَصْحَـٰبِ","with (the) Companions","bi-aṣḥābi","",[["بِ",10],["أَصْحَـٰبِ",158]]],["ٱلْفِيلِ","(of the) Elephant","l-fīli","",[["ٱلْ",2],["فِيلِ",3993]]]]},{"t":"Did He not make their plan into misguidance?","w":[["أَلَمْ","Did not","alam","",[["أَ",31],["لَمْ",44]]],["يَجْعَلْ","He make","yajʿal",""],["كَيْدَهُمْ","their plan","kaydahum","",[["كَيْدَ",425],["هُمْ",3]]],["فِى","go","fī",""],["تَضْلِيلٍۢ","astray","taḍlīlin",""]]},{"t":"And He sent against them birds in flocks,","w":[["وَأَرْسَلَ","And He sent","wa-arsala","",[["وَ",1],["أَرْسَلَ",106]]],["عَلَيْهِمْ","against them","ʿalayhim","",[["عَلَيْ",19],["هِمْ",3]]],["طَيْرًا","birds","ṭayran",""],["أَبَابِيلَ","(in) flocks","abābīla",""]]},{"t":"Striking them with stones of hard clay,","w":[["تَرْمِيهِم","Striking them","tarmīhim","",[["تَرْمِي",896],["هِم",3]]],["بِحِجَارَةٍۢ","with stones","biḥijāratin","",[["بِ",10],["حِجَارَةٍۢ",819]]],["مِّن","of","min",""],["سِجِّيلٍۢ","baked clay","sijjīlin",""]]},{"t":"And He made them like eaten straw.","w":[["فَجَعَلَهُمْ","Then He made them","fajaʿalahum","",[["فَ",7],["جَعَلَ",45],["هُمْ",3]]],["كَعَصْفٍۢ","like straw","kaʿaṣfin","",[["كَ",54],["عَصْفٍۢ",1904]]],["مَّأْكُولٍۭ","eaten up","makūlin",""]]}]}