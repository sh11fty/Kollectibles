ly lost.\"","w":[["وَإِذَا","And when","wa-idhā","",[["وَ",1],["إِذَا",36]]],["رَأَوْهُمْ","they saw them","ra-awhum","",[["رَأَ",60],["وْ",3],["هُمْ",3]]],["قَالُوٓا۟","they said","qālū","",[["قَالُ",16],["وٓا۟",3]]],["إِنَّ","Indeed","inna",""],["هَـٰٓؤُلَآءِ","these","hāulāi","",[["هَ",0],["ـٰٓؤُلَآءِ",262]]],["لَضَآلُّونَ","surely have gone astray","laḍāllūna","",[["لَ",23],["ضَآلُّونَ",653]]]]},{"t":"But they had not been sent as guardians over them.","w":[["وَمَآ","But not","wamā","",[["وَ",1],["مَآ",12]]],["أُرْسِلُوا۟","they had been sent","ur'silū","",[["أُرْسِلُ",106],["وا۟",3]]],["عَلَيْهِمْ","over them","ʿalayhim","",[["عَلَيْ",19],["هِمْ",3]]],["حَـٰفِظِينَ","(as) guardians","ḥāfiẓīna",""]]},{"t":"So Today those who believed are laughing at the disbelievers,","w":[["فَٱلْيَوْمَ","So today","fal-yawma","",[["فَ",7],["ٱلْ",2],["يَوْمَ",33]]],["ٱلَّذِينَ","those who","alladhīna",""],["ءَامَنُوا۟","believed ","āmanū","",[["ءَامَنُ",30],["وا۟",3]]],["مِنَ","at","mina",""],["ٱلْكُفَّارِ","the disbelievers","l-kufāri","",[["ٱلْ",2],["كُفَّارِ",88]]],["يَضْحَكُونَ","they will laugh","yaḍḥakūna","",[["يَضْحَكُ",1084],["ونَ",3]]]]},{"t":"On adorned couches, observing.","w":[["عَلَى","On","ʿalā",""],["ٱلْأَرَآئِكِ","the thrones","l-arāiki","",[["ٱلْ",2],["أَرَآئِكِ",1260]]],["يَنظُرُونَ","observing","yanẓurūna","",[["يَنظُرُ",144],["ونَ",3]]]]},{"t":"Have the disbelievers [not] been rewarded [this Day] for what they used to do?","w":[["هَلْ","Have (not)","hal",""],["ثُوِّبَ","been rewarded","thuwwiba",""],["ٱلْكُفَّارُ","the disbelievers","l-kufāru","",[["ٱلْ",2],["كُفَّارُ",88]]],["مَا","(for) what","mā",""],["كَانُوا۟","they used to","kānū","",[["كَانُ",21],["وا۟",3]]],["يَفْعَلُونَ","do","yafʿalūna","",[["يَفْعَلُ",141],["ونَ",3]]]]}]}