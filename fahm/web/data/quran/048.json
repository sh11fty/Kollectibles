"and is","wakāna","",[["وَ",1],["كَانَ",21]]],["ذَٰلِكَ","that","dhālika","",[["ذَٰ",32],["لِ",0],["كَ",0]]],["عِندَ","with","ʿinda",""],["ٱللَّهِ","Allah","l-lahi",""],["فَوْزًا","a success","fawzan",""],["عَظِيمًۭا","great","ʿaẓīman",""]]},{"t":"And [that] He may punish the hypocrite men and hypocrite women, and the polytheist men and polytheist women - those who assume about Allāh an assumption of evil nature. Upon them is a misfortune of evil nature; and Allāh has become angry with them and has cursed them and prepared for them Hell, and evil it is as a destination.","w":[["وَيُعَذِّبَ","And He (may) punish","wayuʿadhiba","",[["وَ",1],["يُعَذِّبَ",295]]],["ٱلْمُنَـٰفِقِينَ","the hypocrite men","l-munāfiqīna","",[["ٱلْ",2],["مُنَـٰفِقِينَ",413]]],["وَٱلْمُنَـٰفِقَـٰتِ","and the hypocrite women","wal-munāfiqāti","",[["وَ",1],["ٱلْ",2],["مُنَـٰفِقَـٰتِ",1410]]],["وَٱلْمُشْرِكِينَ","and the polytheist men","wal-mush'rikīna","",[["وَ",1],["ٱلْ",2],["مُشْرِكِينَ",277]]],["وَٱلْمُشْرِكَـٰتِ","and the polytheist women","wal-mush'rikāti","",[["وَ",1],["ٱلْ",2],["مُشْرِكَـٰتِ",1405]]],["ٱلظَّآنِّينَ","who assume","l-ẓānīna","",[["ٱل",2],["ظَّآنِّينَ",3827]]],["بِٱللَّهِ","about Allah","bil-lahi","",[["بِ",10],["ٱللَّهِ",9]]],["ظَنَّ","an assumption","ẓanna",""],["ٱلسَّوْءِ","evil","l-sawi","ۚ",[["ٱل",2],["سَّوْءِ",900]]],["عَلَيْهِمْ","Upon them","ʿalayhim","",[["عَلَيْ",19],["هِمْ",3]]],["دَآئِرَةُ","(is) a turn","dāiratu",""],["ٱلسَّوْءِ","(of) evil","l-sawi","ۖ",[["ٱل",2],["سَّوْءِ",900]]],["وَغَضِبَ","and Allah's wrath (is)","waghaḍiba","",[["وَ",1],["غَضِبَ",1195]]],["ٱللَّهُ","and Allah's wrath (is)","l-lahu",""],["عَلَيْهِمْ","upon them","ʿalayhim","",[["عَلَيْ",19],["هِمْ",3]]],["وَلَعَنَهُمْ","and He has cursed them","walaʿanahum","",[["وَ",1],["لَعَنَ",461],["هُمْ",3]]],["وَأَعَدَّ","and prepared","wa-aʿadda","",[["وَ",1],["أَعَدَّ",349]]],["لَهُمْ","for them","lahum","",[["لَ",8],["هُمْ",3]]],["جَهَنَّمَ","Hell","jahannama","ۖ"],["وَسَآءَتْ","and evil","was