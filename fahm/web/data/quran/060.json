thing against Allāh. Our Lord, upon You we have relied, and to You we have returned, and to You is the destination.","w":[["قَدْ","Indeed","qad",""],["كَانَتْ","(there) is","kānat",""],["لَكُمْ","for you","lakum","",[["لَ",8],["كُمْ",4]]],["أُسْوَةٌ","an example","us'watun",""],["حَسَنَةٌۭ","good","ḥasanatun",""],["فِىٓ","in","fī",""],["إِبْرَٰهِيمَ","Ibrahim","ib'rāhīma",""],["وَٱلَّذِينَ","and those","wa-alladhīna","",[["وَ",1],["ٱلَّذِينَ",17]]],["مَعَهُۥٓ","with him","maʿahu","",[["مَعَ",84],["هُۥٓ",5]]],["إِذْ","when","idh",""],["قَالُوا۟","they said","qālū","",[["قَالُ",16],["وا۟",3]]],["لِقَوْمِهِمْ","to their people","liqawmihim","",[["لِ",8],["قَوْمِ",38],["هِمْ",3]]],["إِنَّا","Indeed, we","innā","",[["إِنَّ",15],["ا",11]]],["بُرَءَٰٓؤُا۟","(are) disassociated","buraāu",""],["مِنكُمْ","from you","minkum","",[["مِن",6],["كُمْ",4]]],["وَمِمَّا","and from what","wamimmā","",[["وَ",1],["مِ",6],["مَّا",12]]],["تَعْبُدُونَ","you worship","taʿbudūna","",[["تَعْبُدُ",115],["ونَ",4]]],["مِن","from","min",""],["دُونِ","besides","dūni",""],["ٱللَّهِ","Allah","l-lahi",""],["كَفَرْنَا","We have denied","kafarnā","",[["كَفَرْ",53],["نَا",11]]],["بِكُمْ","you","bikum","",[["بِ",10],["كُمْ",4]]],["وَبَدَا","and has appeared","wabadā","",[["وَ",1],["بَدَا",757]]],["بَيْنَنَا","between us","baynanā","",[["بَيْنَ",61],["نَا",11]]],["وَبَيْنَكُمُ","and between you","wabaynakumu","",[["وَ",1],["بَيْنَ",61],["كُمُ",4]]],["ٱلْعَدَٰوَةُ","enmity","l-ʿadāwatu","",[["ٱلْ",2],["عَدَٰوَةُ",1187]]],["وَٱلْبَغْضَآءُ","and hatred","wal-baghḍāu","",[["وَ",1],["ٱلْ",2],["بَغْضَآءُ",1287]]],["أَبَدًا","forever","abadan",""],["حَتَّىٰ","until","ḥattā",""],["تُؤْمِنُوا۟","you believe","tu'minū","",[["تُؤْمِنُ",30],["وا۟",4]]],["بِٱللَّهِ","in Allah","bil-lahi","",[["بِ",10],["ٱللَّهِ",9]]],["وَحْدَهُۥٓ","Alone","waḥdahu","",[["وَحْدَ",1242],["هُۥٓ",5]]],["إِلَّا","Except","illā",""],["قَوْلَ","(the) saying","qawla",""],["إِبْرَٰهِيمَ","(of) Ibrahim","ib'rāhīma",""],["لِأَبِيهِ","to his father","li-abīhi","",[["لِ",8],["أَبِي",122],["هِ",5]]],["لَأَسْتَغْفِرَنَّ","Surely I ask forgiveness","la-astaghfiranna","",[["لَ",23],["أَسْتَغْفِرَ",299],["نَّ",0]]],["لَكَ","for you","laka","",[["لَ",8],["كَ",18]]],["وَمَآ","but not","wamā","",[["وَ",1],["مَآ",12]]],["أَمْلِكُ","I have power","amliku",""],["لَكَ","for you","laka","",[["لَ",8],["كَ",18]]],["مِنَ","from","mina",""],["ٱللَّهِ","Allah","l-lahi",""],["مِن","of","min",""],["شَىْءٍۢ","anything","shayin","ۖ"],["رَّبَّنَا","Our Lord","rabbanā","",[["رَّبَّ",24],["نَا",11]]],["عَلَيْكَ","upon You","ʿalayka","",[["عَلَيْ",19],["كَ",18]]],["تَوَكَّلْنَا","we put our trust","tawakkalnā","",[["تَوَكَّلْ",305],["نَا",11]]],["وَإِلَيْكَ","and to You","wa-ilayka","",[["وَ",1],["إِلَيْ",26],["كَ",18]]],["أَنَبْنَا","we turn","anabnā","",[["أَنَبْ",753],["نَا",11]]],["وَإِلَيْكَ","and to You","wa-ilayka","",[["وَ",1],["إِلَيْ",26],["كَ",18]]],["ٱلْمَصِيرُ","(is) the final return","l-maṣīru","",[["ٱلْ",2],["مَصِيرُ",400]]]]},{"t":"Our Lord, make us not [objects of] torment for the disbelievers and forgive us, our Lord. Indeed, it is You who is the Exalted in Might, the Wise.\"","w":[["رَبَّنَا","Our Lord","rabbanā","",[["رَبَّ",24],["نَا",11]]],["لَا","(do) not","lā",""],["تَجْعَلْنَا","make us","tajʿalnā","",[["تَجْعَلْ",45],["نَا",11]]],["فِتْنَةًۭ","a trial","fit'natan",""],["لِّلَّذِينَ","for those who","lilladhīna","",[["لِّ",8],["لَّذِينَ",17]]],["كَفَرُوا۟","disbelieve","kafarū","",[["كَفَرُ",53],["وا۟",3]]],["وَٱغْفِرْ","and forgive","wa-igh'fir","",[["وَ",1],["ٱغْفِرْ",192]]],["لَنَا","us","lanā","",[["لَ",8],["نَا",11]]],["رَبَّنَآ","our Lord","rabbanā","ۖ",[["رَبَّ",24],["نَآ",11]]],["إِنَّكَ","Indeed You","innaka","",[["إِنَّ",15],["كَ",18]]],["أَنتَ","[You]","anta",""],["ٱلْعَزِيزُ","(are) the All-Mighty","l-ʿazīzu","",[["ٱلْ",2],["عَزِيزُ",130]]],["ٱلْحَكِيمُ","the All-Wise","l-ḥakīmu","",[["ٱلْ",2],["حَكِيمُ",133]]]]},{"t":"There has certainly been for you in them an excellent pattern for anyone whose hope is in Allāh and the Last Day. And whoever turns away - then indeed, Allāh is the Free of need, the Praiseworthy.","w":[["لَقَدْ","Certainly","laqad","",[["لَ",23],["قَدْ",37]]],["كَانَ","(there) is","kāna",""],["لَكُمْ","for you","lakum","",[["لَ",8],["كُمْ",4]]],["فِيهِمْ","in them","fīhim","",[["فِي",14],["هِمْ",3]]],["أُسْوَةٌ","an example","us'watun",""],["حَسَنَةٌۭ","good","ḥasanatun",""],["لِّمَن","for (he) who","liman","",[["لِّ",8],["مَن",25]]],["كَانَ","is","kāna",""],["يَرْجُوا۟","hopeful","yarjū",""],["ٱللَّهَ","(in) Allah","l-laha",""],["وَٱلْيَوْمَ","and the Day","wal-yawma","",[["وَ",1],["ٱلْ",2],["يَوْمَ",33]]],["ٱلْـَٔاخِرَ","the Last","l-ākhira","ۚ",[["ٱلْ",2],["ـَٔاخِرَ",89]]],["وَمَن","And whoever","waman","",[["وَ",1],["مَن",25]]],["يَتَوَلَّ","turns away","yatawalla",""],["فَإِنَّ","then indeed","fa-inna","",[["فَ",7],["إِنَّ",15]]],["ٱللَّهَ","Allah","l-laha",""],["هُوَ","He","huwa",""],["ٱلْغَنِىُّ","(is) Free of need","l-ghaniyu","",[["ٱلْ",2],["غَنِىُّ",446]]],["ٱلْحَمِيدُ","the Praiseworthy","l-ḥamīdu","",[["ٱلْ",2],["حَمِيدُ",570]]]]},{"t":"Perhaps Allāh will put, between you and those to whom you have been enemies among them, affection. And Allāh is competent, and Allāh is Forgiving and Merciful.","w":[["عَسَى","Perhaps","ʿasā",""],["ٱللَّهُ","Allah","l-lahu",""],["أَن","[that]","an",""],["يَجْعَلَ","will put","yajʿala",""],["بَيْنَكُمْ","between you","baynakum","",[["بَيْنَ",61],["كُمْ",4]]],["وَبَيْنَ","and between","wabayna","",[["وَ",1],["بَيْنَ",61]]],["ٱلَّذِينَ","those (to) whom","alladhīna",""],["عَادَيْتُم","you have been enemies","ʿādaytum","",[["عَادَيْ",3839],["تُم",4]]],["مِّنْهُم","among them","min'hum","",[["مِّنْ",6],["هُم",3]]],["مَّوَدَّةًۭ","love","mawaddatan","ۚ"],["وَٱللَّهُ","And Allah","wal-lahu","",[["وَ",1],["ٱللَّهُ",9]]],["قَدِيرٌۭ","(is) All-Powerful","qadīrun","ۚ"],["وَٱللَّهُ","And Allah","wal-lahu","",[["وَ",1],["ٱللَّهُ",9]]],["غَفُورٌۭ","(is) Oft-Forgiving","ghafūrun",""],["رَّحِيمٌۭ","Most Merciful","raḥīmun",""]]},{"t":"Allāh does not forbid you from those who do not fight you because of religion and do not expel you from your homes - from being righteous toward them and acting justly toward them. Indeed, Allāh loves those who act justly.","w":[["لَّا","Not","lā",""],["يَنْهَىٰكُمُ","(does) forbid you","yanhākumu","",[["يَنْهَىٰ",367],["كُمُ",4]]],["ٱللَّهُ","Allah","l-lahu",""],["عَنِ","from","ʿani",""],["ٱلَّذِينَ","those who","alladhīna",""],["لَمْ","(do) not","lam",""],["يُقَـٰتِلُوكُمْ","fight you","yuqātilūkum","",[["يُقَـٰتِلُ",229],["و",3],["كُمْ",4]]],["فِى","in","fī",""],["ٱلدِّينِ","the religion","l-dīni","",[["ٱل",2],["دِّينِ",136]]],["وَلَمْ","and (do) not","walam","",[["وَ",1],["لَمْ",44]]],["يُخْرِجُوكُم","drive you out","yukh'rijūkum","",[["يُخْرِجُ",131],["و",3],["كُم",4]]],["مِّن","of","min",""],["دِيَـٰرِكُمْ","your homes","diyārikum","",[["دِيَـٰرِ",257],["كُمْ",4]]],["أَن","that","an",""],["تَبَرُّوهُمْ","you deal kindly","tabarrūhum","",[["تَبَرُّ",2240],["و",4],["هُمْ",3]]],["وَتُقْسِطُوٓا۟","and deal justly","watuq'siṭū","",[["وَ",1],["تُقْسِطُ",1782],["وٓا۟",4]]],["إِلَيْهِمْ","with them","ilayhim","ۚ",[["إِلَيْ",26],["هِمْ",3]]],["إِنَّ","Indeed","inna",""],["ٱللَّهَ","Allah","l-laha",""],["يُحِبُّ","loves","yuḥibbu",""],["ٱلْمُقْسِطِينَ","those who act justly","l-muq'siṭīna","",[["ٱلْ",2],["مُقْسِطِينَ",2018]]]]},{"t":"Allāh only forbids you from those who fight you because of religion and expel you from your homes and aid in your expulsion - [forbids] that you make allies of them. And whoever makes allies of them, then it is those who are the wrongdoers.","w":[["إِنَّمَا","Only","innamā","",[["إِنَّ",15],["مَا",0]]],["يَنْهَىٰكُمُ","forbids you","yanhākumu","",[["يَنْهَىٰ",367],["كُمُ",4]]],["ٱللَّهُ","Allah","l-lahu",""],["عَنِ","from","ʿani",""],["ٱلَّذِينَ","those who","alladhīna",""],["قَـٰتَلُوكُمْ","fight you","qātalūkum","",[["قَـٰتَلُ",229],["و",3],["كُمْ",4]]],["فِى","in","fī",""],["ٱلدِّينِ","the religion","l-dīni",""