]]},{"t":"But they will not wish for it, ever, because of what their hands have put forth. And Allāh is Knowing of the wrongdoers.","w":[["وَلَا","But not","walā","",[["وَ",1],["لَا",13]]],["يَتَمَنَّوْنَهُۥٓ","they will wish for it","yatamannawnahu","",[["يَتَمَنَّ",1247],["وْنَ",3],["هُۥٓ",5]]],["أَبَدًۢا","ever","abadan",""],["بِمَا","for what","bimā","",[["بِ",10],["مَا",12]]],["قَدَّمَتْ","(have) sent forth","qaddamat",""],["أَيْدِيهِمْ","their hands","aydīhim","ۚ",[["أَيْدِي",116],["هِمْ",3]]],["وَٱللَّهُ","And Allah","wal-lahu","",[["وَ",1],["ٱللَّهُ",9]]],["عَلِيمٌۢ","(is) All-Knowing","ʿalīmun",""],["بِٱلظَّـٰلِمِينَ","of the wrongdoers","bil-ẓālimīna","",[["بِ",10],["ٱل",2],["ظَّـٰلِمِينَ",108]]]]},{"t":"Say, \"Indeed, the death from which you flee - indeed, it will meet you. Then you will be returned to the Knower of the unseen and the witnessed, and He will inform you about what you used to do.\"","w":[["قُلْ","Say","qul",""],["إِنَّ","Indeed","inna",""],["ٱلْمَوْتَ","the death","l-mawta","",[["ٱلْ",2],["مَوْتَ",246]]],["ٱلَّذِى","which","alladhī",""],["تَفِرُّونَ","you flee","tafirrūna","",[["تَفِرُّ",1200],["ونَ",4]]],["مِنْهُ","from it","min'hu","",[["مِنْ",6],["هُ",5]]],["فَإِنَّهُۥ","then surely it","fa-innahu","",[["فَ",7],["إِنَّ",15],["هُۥ",5]]],["مُلَـٰقِيكُمْ","(will) meet you","mulāqīkum","ۖ",[["مُلَـٰقِي",2693],["كُمْ",4]]],["ثُمَّ","Then","thumma",""],["تُرَدُّونَ","you will be sent back","turaddūna","",[["تُرَدُّ",335],["ونَ",4]]],["إِلَىٰ","to","ilā",""],["عَـٰلِمِ","(the) All-Knower","ʿālimi",""],["ٱلْغَيْبِ","(of) the unseen","l-ghaybi","",[["ٱلْ",2],["غَيْبِ",251]]],["وَٱلشَّهَـٰدَةِ","and the witnessed","wal-shahādati","",[["وَ",1],["ٱل",2],["شَّهَـٰدَةِ",423]]],["فَيُنَبِّئُكُم","and He will inform you","fayunabbi-ukum","",[["فَ",7],["يُنَبِّئُ",265],["كُم",4]]],["بِمَا","[of] what","bimā","",[["بِ",10],["مَا",12]]],["كُنتُمْ","you used to","kuntum","",[["كُن",21],["تُمْ",4]]],["تَعْمَلُونَ","do","taʿmalūna","",[["تَعْمَلُ",58],["ونَ"