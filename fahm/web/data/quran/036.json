",2],["عَلِيمُ",85]]]]},{"t":"His command is only when He intends a thing that He says to it, \"Be,\" and it is.","w":[["إِنَّمَآ","Only","innamā","",[["إِنَّ",15],["مَآ",0]]],["أَمْرُهُۥٓ","His Command","amruhu","",[["أَمْرُ",82],["هُۥٓ",5]]],["إِذَآ","when","idhā",""],["أَرَادَ","He intends","arāda",""],["شَيْـًٔا","a thing","shayan",""],["أَن","that","an",""],["يَقُولَ","He says","yaqūla",""],["لَهُۥ","to it","lahu","",[["لَ",8],["هُۥ",5]]],["كُن","Be","kun",""],["فَيَكُونُ","and it is","fayakūnu","",[["فَ",7],["يَكُونُ",21]]]]},{"t":"So exalted is He in whose hand is the realm of all things, and to Him you will be returned.","w":[["فَسُبْحَـٰنَ","So glory be","fasub'ḥāna","",[["فَ",7],["سُبْحَـٰنَ",294]]],["ٱلَّذِى","(to) the One who","alladhī",""],["بِيَدِهِۦ","in Whose hand","biyadihi","",[["بِ",10],["يَدِ",116],["هِۦ",5]]],["مَلَكُوتُ","is (the) dominion","malakūtu",""],["كُلِّ","(of) all","kulli",""],["شَىْءٍۢ","things","shayin",""],["وَإِلَيْهِ","and to Him","wa-ilayhi","",[["وَ",1],["إِلَيْ",26],["هِ",5]]],["تُرْجَعُونَ","you will be returned","tur'jaʿūna","",[["تُرْجَعُ",157],["ونَ",4]]]]}]}