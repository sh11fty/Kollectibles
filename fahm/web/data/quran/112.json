{"s":112,"v":[{"t":"Say, \"He is Allāh, [who is] One,","w":[["قُلْ","Say","qul",""],["هُوَ","He","huwa",""],["ٱللَّهُ","(is) Allah","l-lahu",""],["أَحَدٌ","the One","aḥadun",""]]},{"t":"Allāh, the Eternal Refuge.","w":[["ٱللَّهُ","Allah","al-lahu",""],["ٱلصَّمَدُ","the Eternal, the Absolute","l-ṣamadu","",[["ٱل",2],["صَّمَدُ",3770]]]]},{"t":"He neither begets nor is born,","w":[["لَمْ","Not","lam",""],["يَلِدْ","He begets","yalid",""],["وَلَمْ","and not","walam","",[["وَ",1],["لَمْ",44]]],["يُولَدْ","He is begotten","yūlad",""]]},{"t":"Nor is there to Him any equivalent.\"","w":[["وَلَمْ","And not","walam","",[["وَ",1],["لَمْ",44]]],["يَكُن","is","yakun",""],["لَّهُۥ","for Him","lahu","",[["لَّ",8],["هُۥ",5]]],["كُفُوًا","equivalent","kufuwan",""],["أَحَدٌۢ","any [one]","aḥadun",""]]}]}