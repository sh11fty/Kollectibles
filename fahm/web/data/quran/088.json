["إِلَى",26]]],["ٱلْجِبَالِ","the mountains","l-jibāli","",[["ٱلْ",2],["جِبَالِ",313]]],["كَيْفَ","how","kayfa",""],["نُصِبَتْ","they are fixed","nuṣibat",""]]},{"t":"And at the earth - how it is spread out?","w":[["وَإِلَى","And towards","wa-ilā","",[["وَ",1],["إِلَى",26]]],["ٱلْأَرْضِ","the earth","l-arḍi","",[["ٱلْ",2],["أَرْضِ",35]]],["كَيْفَ","how","kayfa",""],["سُطِحَتْ","it is spread out","suṭiḥat",""]]},{"t":"So remind, [O Muḥammad]; you are only a reminder.","w":[["فَذَكِّرْ","So remind","fadhakkir","",[["فَ",7],["ذَكِّرْ",546]]],["إِنَّمَآ","only","innamā","",[["إِنَّ",15],["مَآ",0]]],["أَنتَ","you","anta",""],["مُذَكِّرٌۭ","(are) a reminder","mudhakkirun",""]]},{"t":"You are not over them a controller.","w":[["لَّسْتَ","You are not","lasta","",[["لَّسْ",139],["تَ",18]]],["عَلَيْهِم","over them","ʿalayhim","",[["عَلَيْ",19],["هِم",3]]],["بِمُصَيْطِرٍ","a controller","bimuṣayṭirin","",[["بِ",10],["مُصَيْطِرٍ",2682]]]]},{"t":"However, he who turns away and disbelieves","w":[["إِلَّا","But","illā",""],["مَن","whoever","man",""],["تَوَلَّىٰ","turns away","tawallā",""],["وَكَفَرَ","and disbelieves","wakafara","",[["وَ",1],["كَفَرَ",53]]]]},{"t":"Then Allāh will punish him with the greatest punishment.","w":[["فَيُعَذِّبُهُ","Then will punish him","fayuʿadhibuhu","",[["فَ",7],["يُعَذِّبُ",295],["هُ",5]]],["ٱللَّهُ","Allah","l-lahu",""],["ٱلْعَذَابَ","(with) the punishment","l-ʿadhāba","",[["ٱلْ",2],["عَذَابَ",48]]],["ٱلْأَكْبَرَ","greatest","l-akbara","",[["ٱلْ",2],["أَكْبَرَ",439]]]]},{"t":"Indeed, to Us is their return.","w":[["إِنَّ","Indeed","inna",""],["إِلَيْنَآ","to Us","ilaynā","",[["إِلَيْ",26],["نَآ",11]]],["إِيَابَهُمْ","(will be) their return","iyābahum","",[["إِيَابَ",2982],["هُمْ",3]]]]},{"t":"Then indeed, upon Us is their account.","w":[["ثُمَّ","Then","thumma",""],["إِنَّ","indeed","inna",""],["عَلَيْنَا","upon Us","ʿalaynā","",[["عَلَيْ",19],["نَا",11]]],["حِسَابَهُم","(is) their account","ḥisābahum","",[["حِسَابَ",315],["هُم",3]]]]}]}