<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and newer: same as backup_rules.xml - only the learner's progress is backed up or transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_webview/Default/Local Storage" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_webview/Default/Local Storage" />
    </device-transfer>
</data-extraction-rules>
